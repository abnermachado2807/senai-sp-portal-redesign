# ==========================================
# CONFIGURAÇÃO DE AMBIENTE - SENAI-SP ENTERPRISE
# ==========================================

# Configuração do Servidor
NODE_ENV=production
PORT=3000
APP_URL=https://portal.sp.senai.br

# Chaves de API e Serviços Externos (Isole suas credenciais reais no .env local)
GOOGLE_STITCH_API_KEY=sua_chave_secreta_aqui_nunca_commitar
JWT_SECRET=gere_uma_chave_criptografica_forte_de_pelo_menos_256_bits
JWT_EXPIRES_IN=1h

# Banco de Dados (PostgreSQL / RLS Habilitado)
DATABASE_URL=postgresql://senai_app_user:senha_forte@localhost:5432/senai_sp_db?sslmode=require

# Limitação de Taxa (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Políticas de Cookies
COOKIE_SECRET=segredo_para_assinatura_de_cookies_sensíveis
